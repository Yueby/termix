{
  // Base config only. This package ships two runtimes (Node for self-hosting, Workers
  // for the deployment in wrangler.toml), and one tsconfig cannot describe both: the
  // Workers globals and the Node globals collide. It is therefore typechecked twice,
  // by tsconfig.node.json and tsconfig.worker.json — run `pnpm typecheck`, not tsc.
  //
  // Nothing here is inherited by those two except `compilerOptions`: `include`,
  // `exclude` and `files` are not inherited through `extends`, so each sets its own.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "*.ts"],
  "exclude": ["dist"]
}
